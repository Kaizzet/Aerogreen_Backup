# Copy this file to .env and set MQTT_PUBLIC_HOST to this computer's LAN IPv4.
POSTGRES_DB=iotagri
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
# Local host port for pgAdmin. This is bound to 127.0.0.1 in compose.yaml.
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@iotagri.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-local-password
JWT_KEY=change-this-local-jwt-signing-key-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-this-admin-password-1!
ADMIN_FULL_NAME=IOTAgri Administrator
API_PORT=8080
MQTT_PORT=1883
MQTT_PUBLIC_HOST=192.168.12.140
